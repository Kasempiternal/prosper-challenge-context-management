# Optional. The fastest path is the studio: Keys in the top bar, paste the keys there. This file is
# the alternative: copy to backend/.env and fill in. backend/.env is gitignored: no key is in the repo.
# A key pasted in the studio wins over this file for that one call or request.
# Voice and model live in the agent JSON (e.g. example_flow.json), not here.

# OpenAI, the call's LLM (and the OpenAI disambiguator). Required for a call: here or in the studio.
OPENAI_API_KEY=
# ElevenLabs speech-to-text and text-to-speech. Required for a call: here or in the studio.
ELEVENLABS_API_KEY=
# Optional. Command Code key for JEV (disambiguator and call review).
CMD_API_KEY=
# Optional. Directory of agent JSON files; empty means backend/agents.
AGENTS_DIR=

# Not read from this file: RUN_JEV_LIVE=1 in the shell runs the live JEV grader smoke test in pytest.
